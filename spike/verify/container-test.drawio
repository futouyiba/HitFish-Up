<?xml version="1.0" encoding="UTF-8"?>
<!-- Mechanism probe (hand-written test file, NOT builder output): does a real
     drawio container (swimlane / collapsible group) fold on click in the
     chromeless viewer, the way it does in the editor? -->
<mxfile host="fcf-spike-verify" agent="mechanism probe" version="26.0.0" type="device">
  <diagram id="container-fold-test" name="Container fold test">
    <mxGraphModel dx="900" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="NOTE" value="probe: in the viewer, click the two section headers below — do real containers fold natively?" style="text;html=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="80" y="30" width="640" height="30" as="geometry" />
        </mxCell>
        <mxCell id="GRP.SWIM" value="Section A — swimlane container (collapsible=1)" style="swimlane;startSize=32;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;collapsible=1;swimlaneFillColor=#f8fbff;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="440" height="260" as="geometry" />
        </mxCell>
        <mxCell id="GRP.SWIM.C1" value="child 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="GRP.SWIM">
          <mxGeometry x="40" y="60" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="GRP.SWIM.C2" value="child 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="GRP.SWIM">
          <mxGeometry x="40" y="130" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="GRP.SWIM.C3" value="child 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="GRP.SWIM">
          <mxGeometry x="240" y="60" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="GRP.RECT" value="Section B — collapsible rect group (container=1)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;collapsible=1;container=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="600" y="90" width="440" height="260" as="geometry" />
        </mxCell>
        <mxCell id="GRP.RECT.C1" value="child 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="GRP.RECT">
          <mxGeometry x="40" y="60" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="GRP.RECT.C2" value="child 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="GRP.RECT">
          <mxGeometry x="40" y="130" width="160" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
