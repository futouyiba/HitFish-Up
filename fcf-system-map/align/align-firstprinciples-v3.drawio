        <mxCell id="CONST_T" value="Cross-domain Constitution｜十条跨域不变量" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
            <mxGeometry x="1080" y="240" width="400" height="24" as="geometry" />
