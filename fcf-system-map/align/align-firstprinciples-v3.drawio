        <mxCell id="TITLE" value="FCF 总图 · 第一性原理主干 v3 — 依据「中鱼升级｜」分支（Mainline First-Principles / Causal Heritage）Overall System Model v20 + 中层逻辑样板 v8" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
            <mxGeometry x="60" y="16" width="1200" height="28" as="geometry" />
        </mxCell>
        <mxCell id="HINT" value="主干 = WHO / WHEN / RESOLVE 三问；中层 Kernel = q = Σ_r L_r × C_r（同 support 先 Join 再 Reduce）。青色 = 三个 semantic waist；绿色 = Resolver；深绿粗框 = 成功边界 Fish Spawn Commit。" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
