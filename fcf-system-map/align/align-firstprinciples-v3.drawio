        <mxCell id="CONST9" value="&lt;b&gt;10. Production Preserves Semantics&lt;/b&gt;&#10;Bake Once = Semantic Consequence Once" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#555555;" vertex="1" parent="1">
