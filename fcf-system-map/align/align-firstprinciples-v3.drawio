        <mxCell id="CONST0" value="&lt;b&gt;1. Zero Competing Authority&lt;/b&gt;&#10;一个 Concept 恰好一个 Semantic Owner" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#555555;" vertex="1" parent="1">
            <mxGeometry x="1080" y="270" width="400" height="38" as="geometry" />
        </mxCell>
        <mxCell id="CONST1" value="&lt;b&gt;2. Player Command ≠ ActualPresentation&lt;/b&gt;&#10;玩家输入须经装备/技能/物理 realizable 后才被消费" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#555555;" vertex="1" parent="1">
            <mxGeometry x="1080" y="312" width="400" height="38" as="geometry" />
        </mxCell>
        <mxCell id="CONST2" value="&lt;b&gt;3. WHO ≠ WHEN&lt;/b&gt;&#10;鱼偏好 / 动机不得偷偷增加 Opportunity Supply" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#555555;" vertex="1" parent="1">
            <mxGeometry x="1080" y="354" width="400" height="38" as="geometry" />
        </mxCell>
        <mxCell id="CONST3" value="&lt;b&gt;4. Opportunity Species-Agnostic&lt;/b&gt;&#10;形成与评价 support 先于 fish-specific response" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#555555;" vertex="1" parent="1">
            <mxGeometry x="1080" y="396" width="400" height="38" as="geometry" />
        </mxCell>
        <mxCell id="CONST4" value="&lt;b&gt;5. Join Before Reduce&lt;/b&gt;&#10;L 与 C 必须在相同 identity / support 上组合，再按 measure reduce" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#555555;" vertex="1" parent="1">
            <mxGeometry x="1080" y="438" width="400" height="38" as="geometry" />
        </mxCell>
        <mxCell id="CONST5" value="&lt;b&gt;6. Unknown ≠ Zero&lt;/b&gt;&#10;缺数据 = ResolutionIncomplete，不等于 TrueNone" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#555555;" vertex="1" parent="1">
            <mxGeometry x="1080" y="480" width="400" height="38" as="geometry" />
        </mxCell>
        <mxCell id="CONST6" value="&lt;b&gt;7. Current ≠ Future State&lt;/b&gt;&#10;Event@t 只改变 causally-later state，禁止 same-epoch 回填" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#555555;" vertex="1" parent="1">
            <mxGeometry x="1080" y="522" width="400" height="38" as="geometry" />
        </mxCell>
        <mxCell id="CONST7" value="&lt;b&gt;8. Native Truth ≠ Gameplay Policy&lt;/b&gt;&#10;Guarantee / Fallback / Quest 不得伪装成自然原因" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#555555;" vertex="1" parent="1">
            <mxGeometry x="1080" y="564" width="400" height="38" as="geometry" />
        </mxCell>
        <mxCell id="CONST8" value="&lt;b&gt;9. Irreversible Boundaries Forward-Only&lt;/b&gt;&#10;Opportunity / Selection / Commit 一旦接受，下游不得重开上游竞争" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#555555;" vertex="1" parent="1">
            <mxGeometry x="1080" y="606" width="400" height="38" as="geometry" />
